meta {
  name: 07 Buyer Cannot Approve Partner
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/partners/{{pendingPartnerId}}/approval
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "approval_status": "approved"
  }
}

tests {
  test("buyer cannot approve partner", function () {
    expect(res.status).to.equal(403);
  });
}
