meta {
  name: 11 Update Branch
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/branches/{{createdBranchId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{partnerToken}}
}

body:json {
  {
    "phone": "0288888888"
  }
}

tests {
  test("update created branch", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.phone).to.equal("0288888888");
  });
}
