meta {
  name: 09 Create Branch
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/partners/{{approvedPartnerId}}/branches
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{partnerToken}}
}

body:json {
  {
    "branch_name": "Bruno Branch",
    "address": "123 Bruno Street",
    "city": "Ho Chi Minh",
    "district": "District 7",
    "phone": "0289999999"
  }
}

script:post-response {
  bru.setEnvVar("createdBranchId", res.body.data.id);
}

tests {
  test("partner owner creates branch", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.branch_name).to.equal("Bruno Branch");
  });
}
