meta {
  name: 04 Update Partner
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/partners/{{approvedPartnerId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{partnerToken}}
}

body:json {
  {
    "description": "Updated by Bruno"
  }
}

tests {
  test("partner owner can update own partner", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.description).to.equal("Updated by Bruno");
  });
}
