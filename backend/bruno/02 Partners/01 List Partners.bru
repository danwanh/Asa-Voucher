meta {
  name: 01 List Partners
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/partners?approval_status=approved&page=1&limit=20
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminAccountToken}}
}

tests {
  test("admin account can list partners", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.items).to.be.an("array");
  });
}
