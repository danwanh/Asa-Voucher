meta {
  name: 06 Update Created Partner Status
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/partners/{{createdPartnerId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminAccountToken}}
}

body:json {
  {
    "status": "suspended"
  }
}

tests {
  test("admin updates partner status", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("suspended");
  });
}
