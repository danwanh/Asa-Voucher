meta {
  name: 05 Submit Voucher Product
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/voucher-products/{{createdVoucherProductId}}/submit
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{partnerToken}}
}

tests {
  test("owner submits voucher product", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.approval_status).to.equal("pending");
  });
}
