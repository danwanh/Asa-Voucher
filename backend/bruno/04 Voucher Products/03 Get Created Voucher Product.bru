meta {
  name: 03 Get Created Voucher Product
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/voucher-products/{{createdVoucherProductId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{partnerToken}}
}

tests {
  test("owner can get draft voucher", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(bru.getVar("createdVoucherProductId"));
  });
}
