meta {
  name: 10 Update Voucher Image
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/voucher-product-images/{{createdVoucherImageId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{partnerToken}}
}

body:json {
  {
    "sort_order": 4
  }
}

tests {
  test("owner updates voucher image", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.sort_order).to.equal(4);
  });
}
