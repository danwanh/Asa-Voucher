meta {
  name: 07 Activate Voucher Product
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/voucher-products/{{createdVoucherProductId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{partnerToken}}
}

body:json {
  {
    "status": "active"
  }
}

tests {
  test("owner activates approved voucher", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("active");
  });
}
