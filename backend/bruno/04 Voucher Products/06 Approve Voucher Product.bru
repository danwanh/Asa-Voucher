meta {
  name: 06 Approve Voucher Product
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/voucher-products/{{createdVoucherProductId}}/approval
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminContentToken}}
}

body:json {
  {
    "approval_status": "approved"
  }
}

tests {
  test("admin content approves voucher", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.approval_status).to.equal("approved");
  });
}
