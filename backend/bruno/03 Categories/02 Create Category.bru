meta {
  name: 02 Create Category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminContentToken}}
}

script:pre-request {
  bru.setVar("categorySlug", `bruno-category-${Date.now()}`);
}

body:json {
  {
    "name": "Bruno Category",
    "slug": "{{categorySlug}}",
    "description": "Created by Bruno",
    "sort_order": 99
  }
}

script:post-response {
  bru.setEnvVar("createdCategoryId", res.body.data.id);
}

tests {
  test("admin content creates category", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.slug).to.equal(bru.getVar("categorySlug"));
  });
}
