meta {
  name: 04 Update Category
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/categories/{{createdCategoryId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminContentToken}}
}

body:json {
  {
    "description": "Updated by Bruno"
  }
}

tests {
  test("admin content updates category", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.description).to.equal("Updated by Bruno");
  });
}
