meta {
  name: 04 Update Cart Item
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/cart/items/{{createdCartItemId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "quantity": 2
  }
}

tests {
  test("buyer updates cart item", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.quantity).to.equal(2);
  });
}
