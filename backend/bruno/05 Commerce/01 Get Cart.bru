meta {
  name: 01 Get Cart
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/cart
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("buyer can get cart", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.items).to.be.an("array");
  });
}
