meta {
  name: 20 Simulate Payment Success
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/payments/{{seedPaymentId}}/simulate-success
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("payment can be simulated success", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("success");
  });
}
