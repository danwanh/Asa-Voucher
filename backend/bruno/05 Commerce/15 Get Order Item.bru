meta {
  name: 15 Get Order Item
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/order-items/{{seedOrderItemId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("buyer gets order item", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(bru.getVar("seedOrderItemId"));
  });
}
