meta {
  name: 06 Add Checkout Cart Item
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/cart/items
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "voucher_product_id": "{{activeVoucherProductId}}",
    "quantity": 1
  }
}

script:post-response {
  bru.setEnvVar("checkoutCartItemId", res.body.data.id);
}

tests {
  test("buyer adds checkout cart item", function () {
    expect([200, 201]).to.include(res.status);
  });
}
