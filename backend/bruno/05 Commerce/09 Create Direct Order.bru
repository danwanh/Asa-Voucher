meta {
  name: 09 Create Direct Order
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "items": [
      {
        "voucher_product_id": "{{activeVoucherProductId}}",
        "quantity": 1
      }
    ],
    "payment_method": "bank_transfer",
    "note": "Direct order by Bruno"
  }
}

script:post-response {
  bru.setEnvVar("createdOrderId", res.body.data.id);
}

tests {
  test("buyer creates direct order", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.items).to.be.an("array");
  });
}
