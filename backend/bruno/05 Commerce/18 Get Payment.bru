meta {
  name: 18 Get Payment
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/payments/{{createdPaymentId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("buyer gets payment", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(bru.getVar("createdPaymentId"));
  });
}
