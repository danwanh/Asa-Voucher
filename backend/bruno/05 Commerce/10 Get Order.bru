meta {
  name: 10 Get Order
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/orders/{{createdOrderId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("buyer gets own order", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(bru.getVar("createdOrderId"));
  });
}
