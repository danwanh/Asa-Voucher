meta {
  name: 03 Add Cart Item
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/cart/items
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "voucher_product_id": "{{activeVoucherProductId}}",
    "quantity": 1
  }
}

script:post-response {
  bru.setEnvVar("createdCartItemId", res.body.data.id);
}

tests {
  test("buyer adds cart item", function () {
    expect([200, 201]).to.include(res.status);
    expect(res.body.data.quantity).to.equal(1);
  });
}
