meta {
  name: 19 Simulate Payment Failed
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/payments/{{createdPaymentId}}/simulate-failed
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("payment can be simulated failed", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("failed");
  });
}
