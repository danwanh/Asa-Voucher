meta {
  name: 14 List Order Items
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/orders/{{paidOrderId}}/items
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("buyer lists order items", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
  });
}
