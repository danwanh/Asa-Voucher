meta {
  name: 11 Update Order Note
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/orders/{{createdOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "note": "Updated order note by Bruno"
  }
}

tests {
  test("buyer updates order note", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.note).to.equal("Updated order note by Bruno");
  });
}
