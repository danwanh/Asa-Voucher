meta {
  name: 13 Delete Order
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/orders/{{checkoutOrderId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("delete order cancels unpaid order", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("cancelled");
  });
}
