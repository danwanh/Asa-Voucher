meta {
  name: 12 Cancel Order
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/orders/{{createdOrderId}}/cancel
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("buyer cancels unpaid order", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("cancelled");
  });
}
