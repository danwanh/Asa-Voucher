meta {
  name: 02 Login Partner Owner
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "partner.owner@asa.test",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar("partnerToken", res.body.data.access_token);
}

tests {
  test("login partner owner", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.user.role).to.equal("partner_owner");
  });
}
