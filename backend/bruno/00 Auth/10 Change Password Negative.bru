meta {
  name: 10 Change Password Negative
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "current_password": "wrong-password",
    "new_password": "Password123!"
  }
}

vars:pre-request {
  buyerToken: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMDAwMDAwMDAtMDAwMC0wMDAwLTAwMDAtMDAwMDAwMDAwMDAxIiwiZW1haWwiOiJidXllckBhc2EudGVzdCIsInJvbGUiOiJidXllciIsImlhdCI6MTc4NDQ2ODI1MywiZXhwIjoxNzg0NDY5MTUzfQ.u9j4wQO6d3jSbF8RQ5jUpgCjJUKAL9dril1NRUpXy1g
}

tests {
  test("wrong current password is rejected", function () {
    expect(res.status).to.equal(401);
  });
}
