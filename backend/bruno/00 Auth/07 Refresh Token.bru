meta {
  name: 07 Refresh Token
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/refresh
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("buyerToken", res.body.data.access_token);
  }
}

tests {
  test("refresh returns new access token when cookie jar has refresh token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.access_token).to.be.a("string");
  });
}
