meta {
  name: 04 Login Admin Content
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin.content@asa.test",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar("adminContentToken", res.body.data.access_token);
}

tests {
  test("login admin content", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.user.role).to.equal("admin_content");
  });
}
