meta {
  name: 01 Login Buyer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "buyer@asa.test",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar("buyerToken", res.body.data.access_token);
}

tests {
  test("login buyer returns access token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.access_token).to.be.a("string");
    expect(res.body.data.user.role).to.equal("buyer");
  });
}
