meta {
  name: 05 Login Admin Account
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin.operations@asa.test",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar("adminAccountToken", res.body.data.access_token);
}

tests {
    test("login admin operations", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.user.role).to.equal("admin_operations");
  });
}
