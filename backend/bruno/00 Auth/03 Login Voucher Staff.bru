meta {
  name: 03 Login Voucher Staff
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "voucher.staff@asa.test",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar("voucherStaffToken", res.body.data.access_token);
}

tests {
  test("login voucher staff", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.user.role).to.equal("partner_voucher_staff");
  });
}
