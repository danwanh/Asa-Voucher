meta {
  name: 04 Update Own User
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/users/{{buyerId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "full_name": "Seed Buyer Updated By Bruno"
  }
}

vars:pre-request {
  buyerToken: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMDAwMDAwMDAtMDAwMC0wMDAwLTAwMDAtMDAwMDAwMDAwMDA2IiwiZW1haWwiOiJhZG1pbi5hY2NvdW50QGFzYS50ZXN0Iiwicm9sZSI6ImFkbWluX2FjY291bnQiLCJpYXQiOjE3ODQ0Njg5OTAsImV4cCI6MTc4NDQ2OTg5MH0.5SjDkflJ_GJZHPCH2P9hAMO4pwT4l1hwC0xAOxycPe0
}

tests {
  test("buyer can update own profile", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.full_name).to.equal("Seed Buyer Updated By Bruno");
  });
}
