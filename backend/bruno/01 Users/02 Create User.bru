meta {
  name: 02 Create User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminAccountToken}}
}

body:json {
  {
    "email": "{{newUserEmail}}",
    "password": "Password123!",
    "full_name": "Bruno User",
    "role": "buyer"
  }
}

vars:pre-request {
  newUserEmail: 123@gmail.com
  adminAccountToken: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMDAwMDAwMDAtMDAwMC0wMDAwLTAwMDAtMDAwMDAwMDAwMDA2IiwiZW1haWwiOiJhZG1pbi5hY2NvdW50QGFzYS50ZXN0Iiwicm9sZSI6ImFkbWluX2FjY291bnQiLCJpYXQiOjE3ODQ0Njg5OTAsImV4cCI6MTc4NDQ2OTg5MH0.5SjDkflJ_GJZHPCH2P9hAMO4pwT4l1hwC0xAOxycPe0
}

script:pre-request {
  bru.setVar("newUserEmail", `bruno.user.${Date.now()}@asa.test`);
}

script:post-response {
  bru.setEnvVar("createdUserId", res.body.data.id);
}

tests {
  test("admin creates user", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.role).to.equal("buyer");
  });
}
