generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String              @unique @db.VarChar(255)
  phone                 String?             @unique @db.VarChar(20)
  password_hash         String              @db.VarChar(255)
  full_name             String              @db.VarChar(100)
  avatar_url            String?
  role                  String              @db.VarChar(50)
  dob                   DateTime?           @db.Date
  gender                String?             @db.VarChar(20)
  address               String?
  city                  String?             @db.VarChar(100)
  district              String?             @db.VarChar(100)
  is_active             Boolean             @default(true)
  is_verified           Boolean             @default(false)
  partner_branches_id   String?             @db.Uuid
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  failed_login_attempts Int                 @default(0)
  locked_until          DateTime?           @db.Timestamptz(6)
  auth_version          Int                 @default(0)
  partner_id            String?             @db.Uuid
  admin_logs            AdminLog[]          @relation("AdminLogAdmin")
  targeted_admin_logs   AdminLog[]          @relation("AdminLogTargetUser")
  auth_tokens           AuthToken[]
  authentication_logs   AuthenticationLog[]
  carts                 Cart?
  cms_contents          CmsContent[]        @relation("CmsContentCreator")
  complaint_responses   ComplaintResponse[]
  assigned_complaints   Complaint[]         @relation("ComplaintAssignee")
  complaints            Complaint[]         @relation("ComplaintUser")
  issued_vouchers       IssuedVoucher[]
  notifications         Notification[]
  order_logs            OrderLog[]
  received_orders       Order[]             @relation("ReceivedOrders")
  orders                Order[]             @relation("CreatedOrders")
  approved_partners     Partner[]           @relation("PartnerApprover")
  represented_partners  Partner[]           @relation("PartnerRepresentative")
  payment_logs          PaymentLog[]
  refresh_tokens        RefreshToken[]
  review_responses      ReviewResponse[]
  reviews               Review[]
  reviewed_alerts       SecurityAlert[]     @relation("SecurityAlertReviewer")
  security_alerts       SecurityAlert[]     @relation("SecurityAlertUser")
  partner_branches      PartnerBranch?      @relation("UserBranch", fields: [partner_branches_id], references: [id], onUpdate: NoAction, map: "users_partner_branch_fk")
  partner               Partner?            @relation("PartnerEmployees", fields: [partner_id], references: [id], onUpdate: NoAction, map: "users_partner_fk")
  approved_vouchers     VoucherProduct[]    @relation("VoucherApprover")
  created_vouchers      VoucherProduct[]    @relation("VoucherCreator")
  submitted_vouchers    VoucherProduct[]    @relation("VoucherSubmitter")
  voucher_usages        VoucherUsage[]      @relation("VoucherUsageRedeemer")

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("refresh_tokens")
}

model AuthToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  type       String    @db.VarChar(30)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, type, expires_at], map: "auth_tokens_lookup_idx")
  @@map("auth_tokens")
}

model AuthenticationLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(100)
  status      String   @db.VarChar(50)
  ip_address  String?  @db.VarChar(45)
  user_agent  String?
  occurred_at DateTime @default(now()) @db.Timestamptz(6)
  users       User?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([user_id, occurred_at])
  @@map("authentication_logs")
}

model AdminLog {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id          String          @db.Uuid
  target_user_id    String?         @db.Uuid
  target_partner_id String?         @db.Uuid
  target_voucher_id String?         @db.Uuid
  action            String          @db.VarChar(100)
  description       String?
  occurred_at       DateTime        @default(now()) @db.Timestamptz(6)
  target_order_id   String?         @db.Uuid
  content_type      String?         @db.VarChar(50)
  admin             User            @relation("AdminLogAdmin", fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  target_order      Order?          @relation(fields: [target_order_id], references: [id])
  target_partner    Partner?        @relation(fields: [target_partner_id], references: [id], onUpdate: NoAction, map: "admin_logs_target_partner_fk")
  target_user       User?           @relation("AdminLogTargetUser", fields: [target_user_id], references: [id], onUpdate: NoAction)
  target_voucher    VoucherProduct? @relation(fields: [target_voucher_id], references: [id], onUpdate: NoAction, map: "admin_logs_target_voucher_fk")

  @@map("admin_logs")
}

model Partner {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  representative_user_id String           @db.Uuid
  business_name          String           @db.VarChar(255)
  business_code          String           @unique @db.VarChar(50)
  business_type          String?          @db.VarChar(100)
  tax_number             String?          @unique @db.VarChar(20)
  logo_url               String?
  website_url            String?
  description            String?
  approval_status        String           @default("pending") @db.VarChar(20)
  status                 String           @default("active") @db.VarChar(20)
  approved_by            String?          @db.Uuid
  approved_at            DateTime?        @db.Timestamptz(6)
  created_at             DateTime         @default(now()) @db.Timestamptz(6)
  updated_at             DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  admin_logs             AdminLog[]
  partner_branches       PartnerBranch[]
  approver               User?            @relation("PartnerApprover", fields: [approved_by], references: [id], onUpdate: NoAction)
  representative_user    User             @relation("PartnerRepresentative", fields: [representative_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees              User[]           @relation("PartnerEmployees")
  voucher_products       VoucherProduct[]

  @@index([representative_user_id])
  @@map("partners")
}

model PartnerBranch {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner_id               String                 @db.Uuid
  branch_name              String                 @db.VarChar(255)
  address                  String
  city                     String                 @db.VarChar(100)
  district                 String?                @db.VarChar(100)
  phone                    String?                @db.VarChar(20)
  latitude                 Float?
  longitude                Float?
  is_active                Boolean                @default(true)
  created_at               DateTime               @default(now()) @db.Timestamptz(6)
  partners                 Partner                @relation(fields: [partner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                    User[]                 @relation("UserBranch")
  voucher_product_branches VoucherProductBranch[]
  voucher_usages           VoucherUsage[]

  @@map("partner_branches")
}

model Category {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id        String?          @db.Uuid
  name             String           @db.VarChar(100)
  slug             String           @unique @db.VarChar(100)
  description      String?
  sort_order       Int              @default(0)
  parent           Category?        @relation("CategoryTree", fields: [parent_id], references: [id], onUpdate: NoAction)
  children         Category[]       @relation("CategoryTree")
  voucher_products VoucherProduct[]

  @@map("categories")
}

model VoucherProduct {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner_id               String                 @db.Uuid
  category_id              String                 @db.Uuid
  name                     String                 @db.VarChar(255)
  description              String?
  thumbnail_url            String?
  original_price           Decimal                @db.Decimal(15, 0)
  selling_price            Decimal                @db.Decimal(15, 0)
  discount_rate            Float                  @default(0)
  applicable_area          String?                @db.VarChar(255)
  total_quantity           Int
  remaining_quantity       Int
  terms_and_conditions     Json?
  usage_instructions       Json?
  sale_start_date          DateTime               @db.Date
  sale_end_date            DateTime               @db.Date
  validity_days            Int
  status                   String                 @default("draft") @db.VarChar(20)
  approval_status          String                 @default("pending") @db.VarChar(20)
  approved_by              String?                @db.Uuid
  approved_at              DateTime?              @db.Timestamptz(6)
  created_at               DateTime               @default(now()) @db.Timestamptz(6)
  updated_at               DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  created_by               String?                @db.Uuid
  submitted_by             String?                @db.Uuid
  submitted_at             DateTime?              @db.Timestamptz(6)
  admin_logs               AdminLog[]
  cart_items               CartItem[]
  issued_vouchers          IssuedVoucher[]
  order_items              OrderItem[]
  reviews                  Review[]
  voucher_product_branches VoucherProductBranch[]
  voucher_product_images   VoucherProductImage[]
  approver                 User?                  @relation("VoucherApprover", fields: [approved_by], references: [id], onUpdate: NoAction)
  categories               Category               @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  creator                  User?                  @relation("VoucherCreator", fields: [created_by], references: [id])
  partners                 Partner                @relation(fields: [partner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submitter                User?                  @relation("VoucherSubmitter", fields: [submitted_by], references: [id])

  @@index([partner_id])
  @@index([approval_status, status, sale_start_date, sale_end_date], map: "voucher_products_public_listing_idx")
  @@map("voucher_products")
}

model VoucherProductImage {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_product_id String         @db.Uuid
  image_url          String
  is_primary         Boolean        @default(false)
  sort_order         Int            @default(0)
  voucher_products   VoucherProduct @relation(fields: [voucher_product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("voucher_product_images")
}

model VoucherProductBranch {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_product_id String         @db.Uuid
  branch_id          String         @db.Uuid
  partner_branches   PartnerBranch  @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  voucher_products   VoucherProduct @relation(fields: [voucher_product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([voucher_product_id, branch_id])
  @@map("voucher_product_branches")
}

model Cart {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String     @unique @db.Uuid
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  cart_items CartItem[]
  users      User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("carts")
}

model CartItem {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id            String         @db.Uuid
  voucher_product_id String         @db.Uuid
  quantity           Int
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  carts              Cart           @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  voucher_products   VoucherProduct @relation(fields: [voucher_product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cart_id, voucher_product_id])
  @@index([cart_id])
  @@map("cart_items")
}

model Order {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_code         String       @unique @db.VarChar(30)
  user_id            String       @db.Uuid
  subtotal           Decimal      @db.Decimal(15, 0)
  discount_amount    Decimal      @default(0) @db.Decimal(15, 0)
  total_amount       Decimal      @db.Decimal(15, 0)
  payment_method     String       @db.VarChar(30)
  status             String       @default("pending") @db.VarChar(20)
  note               String?
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  updated_at         DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  recipient_id       String       @db.Uuid
  is_gift            Boolean      @default(false)
  payment_expires_at DateTime?    @db.Timestamptz(6)
  payment_status     String       @default("pending") @db.VarChar(20)
  admin_logs         AdminLog[]
  complaints         Complaint[]
  order_items        OrderItem[]
  order_logs         OrderLog[]
  recipient          User         @relation("ReceivedOrders", fields: [recipient_id], references: [id])
  users              User         @relation("CreatedOrders", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment_logs       PaymentLog[]
  payments           Payment[]

  @@index([user_id])
  @@index([recipient_id])
  @@map("orders")
}

model OrderItem {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id               String          @db.Uuid
  voucher_product_id     String          @db.Uuid
  quantity               Int
  unit_price             Decimal         @db.Decimal(15, 0)
  snapped_original_price Decimal         @db.Decimal(15, 0)
  snapped_selling_price  Decimal         @db.Decimal(15, 0)
  snapped_discount_rate  Float
  subtotal               Decimal         @db.Decimal(15, 0)
  created_at             DateTime        @default(now()) @db.Timestamptz(6)
  issued_vouchers        IssuedVoucher[]
  orders                 Order           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  voucher_products       VoucherProduct  @relation(fields: [voucher_product_id], references: [id], onUpdate: NoAction)

  @@index([order_id])
  @@map("order_items")
}

model Payment {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id         String       @db.Uuid
  method           String       @db.VarChar(30)
  amount           Decimal      @db.Decimal(15, 0)
  status           String       @default("pending") @db.VarChar(20)
  transaction_ref  String?      @db.VarChar(255)
  gateway_response String?
  paid_at          DateTime?    @db.Timestamptz(6)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  refund_ref       String?      @db.VarChar(255)
  refunded_at      DateTime?    @db.Timestamptz(6)
  payment_logs     PaymentLog[]
  orders           Order        @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id])
  @@map("payments")
}

model OrderLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id    String   @db.Uuid
  user_id     String   @db.Uuid
  action      String   @db.VarChar(100)
  description String?
  occurred_at DateTime @default(now()) @db.Timestamptz(6)
  orders      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("order_logs")
}

model PaymentLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id  String   @db.Uuid
  order_id    String   @db.Uuid
  user_id     String   @db.Uuid
  action      String   @db.VarChar(100)
  status      String   @db.VarChar(50)
  amount      Decimal  @db.Decimal(15, 0)
  occurred_at DateTime @default(now()) @db.Timestamptz(6)
  orders      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments    Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("payment_logs")
}

model IssuedVoucher {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_code       String         @unique @db.VarChar(50)
  qr_code_payload    String         @unique @db.VarChar(255)
  qr_code_image_url  String?
  order_item_id      String?        @db.Uuid
  voucher_product_id String         @db.Uuid
  owner_id           String?        @db.Uuid
  issued_date        DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  expired_date       DateTime       @db.Date
  status             String         @default("active") @db.VarChar(20)
  is_test            Boolean        @default(false)
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  complaints         Complaint[]
  order_items        OrderItem?     @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  owners             User?          @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  voucher_products   VoucherProduct @relation(fields: [voucher_product_id], references: [id], onUpdate: NoAction)
  reviews            Review[]
  voucher_usages     VoucherUsage[]

  @@index([owner_id])
  @@map("issued_vouchers")
}

model VoucherUsage {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issued_voucher_id String        @db.Uuid
  branch_id         String        @db.Uuid
  redeemed_by       String        @db.Uuid
  redemption_code   String?       @db.VarChar(50)
  used_at           DateTime      @db.Timestamptz(6)
  note              String?
  partner_branches  PartnerBranch @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  issued_vouchers   IssuedVoucher @relation(fields: [issued_voucher_id], references: [id], onDelete: Cascade)
  redeemer          User          @relation("VoucherUsageRedeemer", fields: [redeemed_by], references: [id], onDelete: Cascade)

  @@index([issued_voucher_id])
  @@map("voucher_usages")
}

model Review {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_product_id String           @db.Uuid
  user_id            String           @db.Uuid
  issued_voucher_id  String           @db.Uuid
  rating             Int
  comment            String?
  media_urls         Json?
  is_published       Boolean          @default(true)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  review_responses   ReviewResponse[]
  issued_vouchers    IssuedVoucher    @relation(fields: [issued_voucher_id], references: [id], onDelete: Cascade)
  users              User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  voucher_products   VoucherProduct   @relation(fields: [voucher_product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, issued_voucher_id])
  @@index([voucher_product_id])
  @@index([user_id])
  @@map("reviews")
}

model ReviewResponse {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  review_id    String   @db.Uuid
  responded_by String   @db.Uuid
  content      String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  responder    User     @relation(fields: [responded_by], references: [id], onDelete: Cascade)
  reviews      Review   @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@index([review_id])
  @@map("review_responses")
}

model Complaint {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id            String?             @db.Uuid
  issued_voucher_id   String?             @db.Uuid
  user_id             String              @db.Uuid
  reason              String              @db.VarChar(100)
  description         String
  evidence_urls       Json?
  status              String              @default("open") @db.VarChar(20)
  assigned_to         String?             @db.Uuid
  resolution_note     String?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  resolved_at         DateTime?           @db.Timestamptz(6)
  resolution_types    Json?               @db.Json
  complaint_responses ComplaintResponse[]
  assignee            User?               @relation("ComplaintAssignee", fields: [assigned_to], references: [id])
  issued_vouchers     IssuedVoucher?      @relation(fields: [issued_voucher_id], references: [id])
  orders              Order?              @relation(fields: [order_id], references: [id])
  users               User                @relation("ComplaintUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, issued_voucher_id])
  @@index([user_id])
  @@index([status])
  @@map("complaints")
}

model ComplaintResponse {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaint_id   String    @db.Uuid
  responded_by   String    @db.Uuid
  responder_role String    @db.VarChar(50)
  content        String
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  complaints     Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)
  responder      User      @relation(fields: [responded_by], references: [id], onDelete: Cascade)

  @@index([complaint_id])
  @@map("complaint_responses")
}

model SecurityAlert {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  alert_type  String    @db.VarChar(50)
  detail      String?
  ip_address  String?   @db.VarChar(50)
  status      String    @default("open") @db.VarChar(20)
  reviewed_by String?   @db.Uuid
  reviewed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  reviewer    User?     @relation("SecurityAlertReviewer", fields: [reviewed_by], references: [id])
  user        User      @relation("SecurityAlertUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@map("security_alerts")
}

model Role {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String           @unique @db.VarChar(50)
  name             String           @db.VarChar(100)
  description      String?
  color            String?          @db.VarChar(20)
  is_system        Boolean          @default(false)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  role_permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String           @unique @db.VarChar(100)
  module           String           @db.VarChar(50)
  action           String           @db.VarChar(100)
  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model CmsContent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_type String    @db.VarChar(50)
  title        String    @db.VarChar(255)
  content      String?
  image_url    String?   @db.VarChar(500)
  status       String    @default("active") @db.VarChar(20)
  sort_order   Int       @default(0)
  created_by   String?   @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  creator      User?     @relation("CmsContentCreator", fields: [created_by], references: [id])

  @@index([content_type])
  @@index([status])
  @@map("cms_contents")
}

model Notification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(255)
  content    String?
  ref_type   String?  @db.VarChar(50)
  ref_id     String?  @db.Uuid
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([user_id, created_at(sort: Desc)])
  @@map("notifications")
}
