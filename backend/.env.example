NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=

JWT_SECRET=my-super-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
# Gmail SMTP. Use a Google App Password, never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
AUTH_TOKEN_EXPIRES_IN_MINUTES=30

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/v1/payments/vnpay/return

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_RETURN_URL=http://localhost:5000/api/v1/payments/paypal/return
PAYPAL_CANCEL_URL=http://localhost:5000/api/v1/payments/paypal/cancel
PAYPAL_CURRENCY=USD
PAYPAL_VND_TO_USD_RATE=25000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
